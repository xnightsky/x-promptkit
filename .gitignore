__pycache__/
*.pyc

# Local Codex marker file in repo root
/.codex

# recall-evaluator provider 矩阵:真实密钥写在「使用方仓库根目录」的下列文件里，
# 这些文件绝不入库;仓库内仅保留 .recall-replay.env.example.yaml 模板。
/.recall-replay.env.yaml
/.recall-replay.env.yml
/.recall-replay.env

# npx skills add 生成的安装产物与 lockfile
skills-lock.json
/.*/skills/

# Claude Code 插件本地安装态：install-dev-plugin.mjs 装进本仓(project scope)时会写 .claude/settings.json，
# 属本机安装产物、不入库。
.claude/

# superpowers subagent-driven-development 的进度台账/scratch，属本机执行态、不入库。
.superpowers/
