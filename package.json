{
  "name": "x-promptkit",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:code && npm run lint:docs && npm run lint:repo",
    "lint:code": "node scripts/tooling/lint-code.mjs",
    "lint:docs": "node scripts/tooling/lint-docs.mjs",
    "lint:repo": "node scripts/tooling/lint-repo.mjs",
    "check": "npm run check:fixtures",
    "check:fixtures": "node scripts/tooling/check-fixtures.mjs",
    "verify": "npm run lint && npm run check && npm test && npm run iitest",
    "test": "node scripts/tooling/run-tests.mjs",
    "iitest": "node scripts/tooling/run-integration-tests.mjs",
    "test:recall-unit": "node --test tests/recall-eval.lib.test.mjs",
    "test:recall-cli": "node --test tests/recall-eval.test.mjs",
    "test:recall-replay-unit": "node --test tests/recall-eval.replay.test.mjs",
    "iitest:ai-run": "node --test integration-tests/ai-run/",
    "iitest:token:recall-replay": "node integration-tests/recall-eval/recall-replay.token.ittest.mjs",
    "iitest:token:recall-live": "node --test integration-tests/recall-eval/recall-live.token.ittest.mjs",
    "iitest:token:skill-trigger-permissions": "node --test integration-tests/recall-eval/skill-trigger-permissions.token.ittest.mjs",
    "recall:sync-shared": "node skills-def/recall-eval/scripts/sync-shared.mjs",
    "recall:validate": "node skills-def/recall-eval/scripts/validate-schema.mjs",
    "recall:resolve": "node skills-def/recall-eval/scripts/resolve-target.mjs",
    "recall:run": "node skills-def/recall-eval/scripts/run-eval.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  }
}
